# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---------------------------------------------------------------
# Required. The legacy app's database (analyses, startups, users, ...) and,
# by default, V2's own schema `v2` live in the SAME database unless
# V2_DATABASE_URL below overrides it. Evidence Engine v1's own table
# (evidence_v1_analyses, default/public schema) also targets this same URL
# -- see docs/architecture/EVIDENCE_ENGINE_PRODUCT_INTEGRATION.md for why
# it is migration-managed independently (alembic_evidence_v1.ini) despite
# sharing a database with everything else.
DATABASE_URL=postgresql://localhost/due_diligence

# Optional. Overrides DATABASE_URL for VentureGPS V2 (app/v2/) only, if V2
# should run against a different database. Falls back to DATABASE_URL when unset.
# V2_DATABASE_URL=

# --- Authentication (Clerk) ---------------------------------------------------
# Required for any authenticated route (this is the real security boundary --
# see app/auth.py). The Clerk instance's Frontend API URL, no trailing slash.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Optional, comma-separated. Frontend origin(s) allowed to present a session
# token (validates the JWT `azp` claim). Defaults to localhost:3000/127.0.0.1:3000
# in local development when unset.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Optional, comma-separated Clerk user ids. Empty/unset means no admin --
# never a wildcard, never a fallback identity.
# ADMIN_USER_IDS=

# --- CORS ---------------------------------------------------------------------
# Optional, comma-separated. Defaults to the local dashboard dev origins when unset.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI / research providers (paid) -------------------------------------------
# Required for the legacy analysis pipeline AND for Evidence Engine v1
# (both call the real OpenAI/Tavily APIs -- see app/ai/* and
# app/evidence_engine/acquisition/providers_live.py). Real cost is incurred
# on every completed analysis run, either engine.
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Evidence Engine v1 product integration (Task 31) -------------------------
# Server-side rollout gate for the new Evidence Engine v1 analysis path.
# Safe default: unset/false -> every request runs the existing, unmodified
# legacy pipeline, REGARDLESS of what the client's own `engine` form field
# requests. A client can never authorize evidence_v1 by itself -- this
# server-side flag is the only authorization boundary for rollout.
# Set to true only in an environment where Evidence Engine v1 has been
# explicitly approved to run (see docs/architecture/ADR-evidence-engine-v1-candidate.md).
EVIDENCE_V1_ENABLED=false

# --- Observability (optional) --------------------------------------------------
# SENTRY_DSN=
# ENVIRONMENT=development
